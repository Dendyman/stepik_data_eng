# 1. Используем официальное базовое изображение Python версии 3.11
# Используем slim-версию для уменьшения размера образа
FROM python:3.11-slim

# 2. Определяем рабочую директорию внутри контейнера
# Все последующие команды будут выполняться в /app
WORKDIR /app

# 3. Копируем файл app.py в рабочую директорию образа
# Точка (.) означает текущую рабочую директорию (/app)
COPY app.py .

# 4. Указываем команду, которая будет выполнена при запуске контейнера
CMD ["python", "app.py"]